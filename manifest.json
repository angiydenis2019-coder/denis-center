{
  "name": "DC",
  "short_name": "DC",
  "description": "Trabajos, clientes, turnos y garantías",
  "start_url": "./#/inicio",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0b2e5c",
  "lang": "es-AR",
  "icons": [
    {
      "src": "iconos/icono-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "iconos/icono-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "iconos/icono-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "archivo",
          "accept": [
            "text/vcard",
            "text/x-vcard",
            "text/directory",
            ".vcf",
            "text/plain"
          ]
        }
      ]
    }
  }
}